# Open Chat — release signing template (spec §19–§20).
# Copy to keystore.properties (NEVER commit keystore.properties) and fill in,
# or export the same keys as environment variables / CI secrets.

ANDROID_KEYSTORE_PATH=/absolute/path/to/release.keystore
ANDROID_KEYSTORE_PASSWORD=change-me
ANDROID_KEY_ALIAS=openchat
ANDROID_KEY_PASSWORD=change-me

# CI (GitHub Actions secrets) uses these names instead:
#   ANDROID_KEYSTORE_BASE64  = base64 of the keystore file  (base64 -w0 release.keystore)
#   ANDROID_KEYSTORE_PASSWORD, ANDROID_KEY_ALIAS, ANDROID_KEY_PASSWORD
